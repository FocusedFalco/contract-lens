# Copy to .env (git-ignored) for local use; set the same names in Vercel > Settings > Environment Variables.
# NEVER commit real values, and rotate any key or password that has been pasted into a chat, ticket or screenshot.

# ---------------------------------------------------------------- access control (there are no user accounts)
# REQUIRED on any public host (Vercel / NODE_ENV=production): without it the API refuses to serve anything.
# Visitors type this code once. Use 12+ random characters, e.g.  openssl rand -base64 24
ACCESS_PASSWORD=
# Recommended: a separate random secret used to sign the browser cookie, so the cookie can never be used to guess
# the access code. 32+ random bytes, e.g.  openssl rand -base64 32   (changing it signs everybody out)
SESSION_SECRET=

# ---------------------------------------------------------------- AI provider
# Set ONE of GEMINI_API_KEY / ANTHROPIC_API_KEY. Without either, the app runs in offline demo mode (sample files only).
# PRIVACY: on Google's free (unpaid) Gemini tier, submitted contracts may be used to improve Google products and
# read by human reviewers. For real personal or business documents enable Cloud Billing on the Google project
# behind the key (paid terms), see https://ai.google.dev/gemini-api/terms
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# CL_PROVIDER=gemini            # force a provider if both keys are set
# CL_GEMINI_MODEL=gemini-flash-latest   # alias for the current Flash model; pin a version if you need stable output
# GEMINI_CHAT_API_KEY=           # optional: a separate Gemini key just for the chatbot (e.g. separate quota/billing
                                  # from document extraction). GEMINI_API_KEY above is always used for extraction;
                                  # chat uses this one if set, otherwise falls back to GEMINI_API_KEY too.
# CL_MASK_PII=true               # optional: hide ID-number / PAN / email / phone shaped values from the AI provider.
                                  # Off by default because the patterns can also hide legitimate long numbers.

# Chatbot only, Gemini only, off by default: lets it use live Google Search for questions the contract itself
# can't answer (e.g. "is this penalty typical?"), clearly labelled apart from the contract's own citations.
# Needs a Google Cloud project with Search Grounding billing enabled (it's a paid, per-request feature,
# separate from normal Gemini usage) - without it every attempt fails and the chatbot silently falls back to
# its normal contract-only answers, so it's always safe to turn on.
# CL_WEB_SEARCH=true

# ---------------------------------------------------------------- database
# A Postgres connection string (Supabase, Neon, ...). Blank = embedded local database.
# On Vercel use Supabase's "Transaction pooler" string (port 6543); percent-encode special characters in the password.
# Use a long random password (24+ characters). Row-Level Security is switched on automatically at startup.
DATABASE_URL=
# Recommended for Supabase: its CA certificate (Dashboard > Database > SSL Configuration), PEM text, newlines may be
# written as \n. With it the app verifies it is really talking to Supabase; without it the connection is encrypted but
# the server's identity is not checked.
# DATABASE_CA=

# ---------------------------------------------------------------- limits and alerts
# Per client IP, per hour. Every upload and chat answer is a paid AI call.
# RL_UPLOADS_PER_HOUR=30
# RL_CHATS_PER_HOUR=120
# ALERT_WEBHOOK_URL=            # optional: POST expiry reminders to a webhook
